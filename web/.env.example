# /web — Next.js. Les clés des PROVIDERS IA ne vivent plus ici : elles sont
# dans worker/.env (le worker détient toute la logique de génération).
# Voir ENVIRONMENT.md à la racine du dépôt pour la répartition complète.
# Copier ce fichier vers .env.local.

# URL publique du site. Utiliser une adresse joignable depuis le navigateur.
NEXT_PUBLIC_APP_URL=http://192.168.1.4:3000

# Base Postgres partagée avec /worker (même DB) — port 5433 (le 5432 est
# pris par un éventuel PostgreSQL natif de la machine)
DATABASE_URL=postgresql://renderstudio:renderstudio@127.0.0.1:5433/renderstudio

# Worker FastAPI : base INTERNE (appels serveur Next -> worker)
WORKER_BASE_URL=http://127.0.0.1:8000
# Worker : base PUBLIQUE (le navigateur télécharge /storage/... depuis elle)
WORKER_PUBLIC_URL=http://192.168.1.4:8000
# Supabase Auth (server-only service role key must NEVER be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_YEARLY=

# Worker internal API key (shared secret between /web and /worker)
WORKER_API_KEY=

# Dev fallback: when true and no Supabase session, use the seeded dev user
AUTH_DEBUG=false

# Optional: idle timeout in minutes before automatic logout (default: 30)
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30
