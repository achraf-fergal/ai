# Base Postgres partagée avec /web (même DB) — port 5433 (le 5432 est pris
# par un éventuel PostgreSQL natif de la machine)
DATABASE_URL=postgresql://renderstudio:renderstudio@127.0.0.1:5433/renderstudio

# URL PUBLIQUE du worker, vue par le navigateur (pour /storage/...)
WORKER_PUBLIC_URL=http://127.0.0.1:8000

# Clé secrète partagée avec /web (le worker rejette les requêtes sans X-Worker-Key)
WORKER_API_KEY=dev-secret-change-in-production

# Dossier de stockage local (défaut : ./storage dans worker/)
# STORAGE_DIR=

# ComfyUI local server (MiniMax H3 workflow)
COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_PATH=../video_minimax_h3_i2v.json

# --- Clés des API OFFICIELLES des fournisseurs (worker UNIQUEMENT —
#     elles ne vivent plus dans web/) ---
# Black Forest Labs — Flux Kontext Pro/Max, image (https://dashboard.bfl.ai)
BFL_API_KEY=
# Google Gemini — Nano Banana / Pro, image (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Kling — vidéo (https://app.klingai.com, console développeur).
# Une seule clé est requise : KLING_SECRET_KEY. KLING_ACCESS_KEY est optionnel
# (seulement si votre console Kling fournit une paire AccessKey/SecretKey).
KLING_SECRET_KEY=
# KLING_ACCESS_KEY=api-key-kling-gMzIs-FN_TvdtFkc1n3aIkFGiPq89i7db2LOww2Z1Uw
# Runway — Gen-4 Turbo, vidéo (https://dev.runwayml.com)
RUNWAY_API_KEY=
# OpenAI — GPT Image (image) + Sora 2 (vidéo) (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Magic Hour — agrégateur (exception assumée, voir AGENTS.md §1)
MAGIC_HOUR_API_KEY=
# ElevenLabs — Voice Generator / narration (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# remove.bg — Background Remover (https://www.remove.bg/api)
REMOVEBG_API_KEY=
# Meshy — 3D Generator (https://www.meshy.ai/api)
MESHY_API_KEY=
# Tripo3D — 3D Generator (https://platform.tripo3d.ai)
TRIPO_API_KEY=
# Hunyuan3D — 3D Generator via Replicate (https://replicate.com/tencent/hunyuan3d-2)
HUNYUAN3D_API_KEY=
# Trellis — 3D Generator via Replicate (https://replicate.com/wtybill/trellis)
TRELLIS_API_KEY=
